# API key 环境变量（cp .env.example .env 后填入；.env 已 git-ignore，绝不提交）。
# orchestrator 启动时自动载入；终端里已 export 的同名变量优先于本文件。
# 只需要填你实际使用的厂商那一行。

# DeepSeek（默认 provider）
DEEPSEEK_API_KEY=

# 阿里云百炼 DashScope（--provider bailian）
# DASHSCOPE_API_KEY=

# OpenAI（--provider openai）
# OPENAI_API_KEY=

# Moonshot / Kimi（--provider moonshot）
# MOONSHOT_API_KEY=

# 智谱 GLM（--provider zhipu）
# ZHIPU_API_KEY=

# Anthropic Claude（--provider anthropic）
# ANTHROPIC_API_KEY=

# 任意 OpenAI 兼容端点（--provider openai-compat --api-key-env MY_KEY）
# MY_KEY=
